{
  "name": "freelens-gateway-extension",
  "version": "0.1.0",
  "description": "Freelens extension for Kubernetes Gateway API and NGINX Gateway Fabric resources",
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": ["dist/**/*"],
  "engines": {
    "node": ">= 22.0.0",
    "freelens": "^2.0.0"
  },
  "type": "module",
  "scripts": {
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "build": "pnpm type:check && vite build && vite build --mode main",
    "build:force": "vite build && vite build --mode main",
    "dev:main": "vite build --watch --mode main",
    "dev:renderer": "vite build --watch --no-emptyOutDir",
    "pack:dev": "npm version prerelease --preid dev --no-git-tag-version && pnpm build && pnpm pack",
    "lint:check": "biome check . && prettier --check .",
    "lint:fix": "biome check --write . && prettier --write .",
    "clean": "rm -rf dist out",
    "clean:all": "rm -rf dist out node_modules *.tgz src/**/*.d.scss.ts"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@biomejs/biome": "^1.9.4",
    "@freelensapp/extensions": "^2.0.0",
    "@types/node": "~22.19.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "^44.10.0",
    "esbuild": "^0.25.0",
    "mobx": "^7.0.6",
    "mobx-react": "^10.0.2",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.97.3",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-sass-dts": "^1.3.35"
  },
  "packageManager": "pnpm@10.8.1",
  "keywords": ["extension", "freelensapp", "freelens", "gateway-api", "nginx-gateway-fabric", "kubernetes"],
  "license": "MIT"
}
